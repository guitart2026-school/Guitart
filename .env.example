# =============================================================
# Guitart Academy - Environment Variables (TEMPLATE)
# Copy this file to `.env.local` and fill in your own values:
#     cp .env.example .env.local        (macOS / Linux)
#     copy .env.example .env.local      (Windows CMD)
# Then restart `npm run dev`.
#
# NOTE: NEXT_PUBLIC_* variables are exposed to the browser.
#       NEVER commit real secrets. `.env.local` is git-ignored.
# =============================================================

# ---------- MongoDB (src/lib/mongodb.ts) ----------
# Falls back to mongodb://localhost:27017/guitart_academy if empty
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Falls back to "guitart" if empty
MONGODB_DB=guitart

# ---------- Firebase Auth (src/lib/firebase.ts) ----------
# Firebase Console > Project Settings > General > Your apps (Web)
# API key, auth domain and project id are required to enable Firebase
# Enable "Email/Password" and "Google" under Authentication > Sign-in method
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- Cloudinary uploads (src/lib/cloudinary.ts, /api/upload) ----------
# Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Admin account (login, sync, reset-password, StoreContext) ----------
# Default fallback email in code: ershad@guitart.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_EMAIL=admin@example.com
# Default fallback password in code: admin123 (change it!)
# NEXT_PUBLIC_ADMIN_PASSWORD is visible in the browser bundle - prefer ADMIN_DEFAULT_PASSWORD
ADMIN_DEFAULT_PASSWORD=change-me
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# ---------- Password reset email via Gmail SMTP (src/lib/mailer.ts) ----------
# Gmail address used to send the mail
GMAIL_USER=
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
# Spaces are stripped automatically. If both are empty, emails are simulated in the console.
GMAIL_APP_PASSWORD=

# ---------- App URL (src/app/api/auth/reset-password/route.ts) ----------
# Base URL used in reset links. Falls back to VERCEL_URL, then http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
